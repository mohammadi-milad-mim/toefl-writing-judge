OPENAI_API_KEY=your-avalai-api-key
OPENAI_BASE_URL=https://api.avalai.ir/v1

# Current official standard API list prices, verified 2026-07-16.
# All rates are USD per 1 million tokens. Change them if your gateway adds markup.

# Introductory pricing through 2026-08-31; afterward Anthropic lists $3/$0.30/$15.
MODEL_1=claude-sonnet-5
MODEL_1_INPUT_USD_PER_MILLION=2.00
MODEL_1_CACHED_INPUT_USD_PER_MILLION=0.20
MODEL_1_OUTPUT_USD_PER_MILLION=10.00

# Current stable Flash model and standard pricing.
MODEL_2=gemini-3.5-flash
MODEL_2_INPUT_USD_PER_MILLION=1.50
MODEL_2_CACHED_INPUT_USD_PER_MILLION=0.15
MODEL_2_OUTPUT_USD_PER_MILLION=9.00

# Standard pricing for prompts up to 272K tokens.
MODEL_3=gpt-5.6-terra
MODEL_3_INPUT_USD_PER_MILLION=2.50
MODEL_3_CACHED_INPUT_USD_PER_MILLION=0.25
MODEL_3_OUTPUT_USD_PER_MILLION=15.00

# Optional. The assessments are detailed, so leave enough output room.
MAX_OUTPUT_TOKENS=20000

# Hard timeout for each individual LLM request: 4 minutes.
LLM_TIMEOUT_SECONDS=240
